<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 8.0（API 26）的系統導覽列。
      SystemBars 的 style: 'LIGHT' 在執行期會把導覽列按鈕設成深色（API 26 就有這個旗標），
      但主題沒有設底色時是黑底，深色按鈕疊在黑底上看不到。這裡把底色設成白的。
      windowLightNavigationBar 這個主題屬性是 API 27 才有，所以 26 只設底色，按鈕顏色交給 SystemBars；
      27 以上用 values-v27（兩個都設，啟動畫面結束前就是對的顏色）。
      API 24、25 沒有深色導覽按鈕，維持平台預設的黑底白按鈕。
      其餘三行與 values/styles.xml 的 AppTheme.NoActionBar 相同（同名 style 在這裡是整個取代，不是合併）。
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:navigationBarColor">@android:color/white</item>
    </style>
</resources>
